# =============================================================================
# EcoPet — Vercel PRODUCTION (importação em massa)
# =============================================================================
# Uso: Vercel → Project → Settings → Environment Variables → Import / Paste
#      Selecione APENAS o ambiente "Production".
# NÃO commitar este arquivo preenchido com secrets.
# Substitua todos os <PLACEHOLDER_*> pelos valores reais.
# Domínio canônico: https://eccopet.com
# =============================================================================

# --- URLs (obrigatório — produção) ---
NEXTAUTH_URL=https://eccopet.com
APP_URL=https://eccopet.com
NEXT_PUBLIC_APP_URL=https://eccopet.com

# --- Auth (segredo — forte, ≥32 chars; NÃO use change-me) ---
AUTH_SECRET=<PLACEHOLDER_AUTH_SECRET_MIN_32>
NEXTAUTH_SECRET=<PLACEHOLDER_AUTH_SECRET_MIN_32>

# --- Banco produção (segredo — pooler + direct) ---
DATABASE_URL=<PLACEHOLDER_SUPABASE_POOLER_URL_PRODUCTION>
DIRECT_URL=<PLACEHOLDER_SUPABASE_DIRECT_URL_PRODUCTION>

# --- E-mail Resend (segredo servidor) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=<PLACEHOLDER_RESEND_API_KEY>
EMAIL_FROM=<PLACEHOLDER_EMAIL_FROM_VERIFIED_DOMAIN>
EMAIL_FROM_NAME=EcoPet
EMAIL_REPLY_TO=
EMAIL_SUPPORT=<PLACEHOLDER_EMAIL_SUPPORT>
EMAIL_DOMAIN_VERIFIED=true

# --- Upload Cloudinary (API Secret = servidor) ---
UPLOAD_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<PLACEHOLDER_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<PLACEHOLDER_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<PLACEHOLDER_CLOUDINARY_API_SECRET>
UPLOAD_DEV_FALLBACK=0

# --- Turnstile (site key pública; secret servidor) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<PLACEHOLDER_TURNSTILE_SITE_KEY>
TURNSTILE_SECRET_KEY=<PLACEHOLDER_TURNSTILE_SECRET_KEY>
TURNSTILE_ENABLED=true
TURNSTILE_ALLOWED_HOSTNAMES=eccopet.com,www.eccopet.com
TURNSTILE_TIMEOUT_MS=5000

# --- TalkJS ---
# Estado local atual do monorepo: TALKJS_ENVIRONMENT=test (Test Mode).
# NÃO trocar para live automaticamente. Quando o App Live estiver pronto:
#   TALKJS_ENVIRONMENT=live + App ID/Secret Live + TALKJS_WEBHOOK_SECRET + VERIFY=1
NEXT_PUBLIC_TALKJS_APP_ID=<PLACEHOLDER_TALKJS_APP_ID>
TALKJS_SECRET_KEY=<PLACEHOLDER_TALKJS_SECRET_KEY>
TALKJS_ENVIRONMENT=test
TALKJS_API_BASE_URL=https://api.talkjs.com
TALKJS_WEBHOOK_SECRET=<PLACEHOLDER_TALKJS_WEBHOOK_SECRET>
TALKJS_WEBHOOK_VERIFY=0

# --- Mercado Pago ---
# Estado local: MERCADO_PAGO_ENVIRONMENT=production (flag) + PAYMENT_PROVIDER=none.
# Em produção Vercel: use tokens LIVE apenas quando for ativar pagamentos reais.
# Webhook URL: https://eccopet.com/api/webhooks/mercado-pago
PAYMENT_PROVIDER=mercado_pago
MERCADO_PAGO_ENVIRONMENT=production
MERCADO_PAGO_ACCESS_TOKEN=<PLACEHOLDER_MP_ACCESS_TOKEN_LIVE>
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=<PLACEHOLDER_MP_PUBLIC_KEY_LIVE>
MERCADO_PAGO_WEBHOOK_SECRET=<PLACEHOLDER_MP_WEBHOOK_SECRET>

# --- OpenAI (somente servidor) ---
AI_ENABLED=true
OPENAI_API_KEY=<PLACEHOLDER_OPENAI_API_KEY>
OPENAI_PROJECT_ID=<PLACEHOLDER_OPENAI_PROJECT_ID>
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_DAILY_USER_LIMIT=100
OPENAI_MONTHLY_BUDGET_CENTS=20000

# --- Better Stack (token SOMENTE servidor) ---
BETTER_STACK_SOURCE_TOKEN=<PLACEHOLDER_BETTER_STACK_SOURCE_TOKEN>
BETTER_STACK_HOST=<PLACEHOLDER_BETTER_STACK_HOST>
BETTER_STACK_SOURCE_ID=<PLACEHOLDER_BETTER_STACK_SOURCE_ID>
BETTER_STACK_REGION=<PLACEHOLDER_BETTER_STACK_REGION>
BETTER_STACK_ENVIRONMENT=production

# --- Firebase FCM ---
NEXT_PUBLIC_FIREBASE_API_KEY=<PLACEHOLDER_FIREBASE_WEB_API_KEY>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<PLACEHOLDER_FIREBASE_AUTH_DOMAIN>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<PLACEHOLDER_FIREBASE_PROJECT_ID>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<PLACEHOLDER_FIREBASE_STORAGE_BUCKET>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<PLACEHOLDER_FIREBASE_MESSAGING_SENDER_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=<PLACEHOLDER_FIREBASE_APP_ID>
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<PLACEHOLDER_FIREBASE_VAPID_PUBLIC>
FIREBASE_PROJECT_ID=<PLACEHOLDER_FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<PLACEHOLDER_FIREBASE_CLIENT_EMAIL>
FIREBASE_PRIVATE_KEY=<PLACEHOLDER_FIREBASE_PRIVATE_KEY_PEM>
FIREBASE_MESSAGING_ENABLED=true

# --- Google Maps / Analytics / GTM ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<PLACEHOLDER_GOOGLE_MAPS_BROWSER_KEY>
GOOGLE_MAPS_ENABLED=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=<PLACEHOLDER_GA4_MEASUREMENT_ID>
NEXT_PUBLIC_GA_ENABLED=true
NEXT_PUBLIC_GA_CONSENT_DEFAULT=denied
NEXT_PUBLIC_GTM_ID=<PLACEHOLDER_GTM_ID>
NEXT_PUBLIC_GTM_ENABLED=true

# --- Flags ---
SMS_PROVIDER=none
PHONE_SMS_RECOVERY_ENABLED=false
